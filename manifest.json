{
  "manifest_version": 3,
  "name": "Class Silence Guard",
  "version": "1.0.0",
  "description": "Monitors tab audio during online classes and closes Chrome after 2 minutes of continuous silence.",
  "permissions": [
    "tabCapture",
    "offscreen",
    "activeTab",
    "notifications"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "Class Silence Guard"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
